# ─────────────────────────────────────────────────────────────────────────────
# SGBIT Attendance System — Environment Variables
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB
MONGO_URI=mongodb://localhost:27017/
DB_NAME=sgbit_attendance

# Flask
FLASK_SECRET_KEY=sgbit_change_this_secret_2026
FLASK_DEBUG=True
FLASK_PORT=5000

# Faculty Login Credentials
FACULTY_USERNAME=admin
FACULTY_PASSWORD=sgbit@2026

# Gmail SMTP (use App Password — NOT your real Gmail password)
# How to get App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Email alert after N consecutive absences
ABSENCE_ALERT_THRESHOLD=2

# Face Recognition
RECOGNITION_THRESHOLD=0.60
REGISTRATION_FRAMES=25
INSIGHTFACE_MODEL_PACK=buffalo_l

# Liveness Detection
LIVENESS_REQUIRED=True
EAR_BLINK_THRESHOLD=0.25
ANTI_SPOOF_THRESHOLD=0.60

# Attendance
ATTENDANCE_THRESHOLD=75
